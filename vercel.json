{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/prompts/ai-product-system-audit/README.md",
      "destination": "/prompts/ai-system-implementation-audit/README.md",
      "permanent": true
    },
    {
      "source": "/prompts/ai-product-system-audit/ai-product-system-audit.en.md",
      "destination": "/prompts/ai-system-implementation-audit/ai-system-implementation-audit.en.md",
      "permanent": true
    },
    {
      "source": "/prompts/ai-product-system-audit/ai-product-system-audit.zh-CN.md",
      "destination": "/prompts/ai-system-implementation-audit/ai-system-implementation-audit.zh-CN.md",
      "permanent": true
    },
    {
      "source": "/prompts/ai-product-system-audit/:path*",
      "destination": "/prompts/ai-system-implementation-audit/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/prompts/testing-evaluation-system/testing-evaluation-system"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
